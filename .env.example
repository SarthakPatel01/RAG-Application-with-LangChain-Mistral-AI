# Mistral API


# Embedding model (local HuggingFace)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# Chroma
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION=documents

# Chunking
CHUNK_SIZE=500
CHUNK_OVERLAP=75

# Retrieval
TOP_K=5

# API
API_HOST=0.0.0.0
API_PORT=8000